/**
 * UAE Ops sync (SAR Logistics LLC, Dubai)
 *
 * Reads the two RPA sheets, writes clean tabs into the dashboard source sheet and pushes them to
 * the dashboard's database (same shape as the USA dashboard):
 *   JPA - SAR_UAE          tab "All LOB's" - the 2025 and 2026 Job Profile Analysis reports stacked
 *   Estimated vs Actual_UAE tabs CY2025, CY2026 - one row per charge line, amounts in AED
 *   -> SAR_UAE - Ops Dashboard (Claude Source): tabs Jobs, ETD-ETA Lines, Ops Mapping
 *   -> /api/mongo-batch (uae_ops_jobs, uae_ops_etdeta, uae_ops_ops_mapping)
 *
 * Run once: setupUaeSheet() (creates the tabs), then dailySyncUae(); setupDailyTrigger() schedules it.
 * Script Properties: BATCH_SECRET (same value as the Vercel env var).
 * Project time zone must be Asia/Kolkata (appsscript.json) - same date convention as USA.
 */

var UAE = {
  JPA_ID: '1-PdQf-p_WyIws9c0DHkvZnBZW-TdB6UYajDJw89VdZk',
  EVA_ID: '1FtQICTDNiRae-jsiNy1xWN7eaebsSyUlRicRl29saeE',
  DEST_ID: '1VgQDAz_2r9nVu5xZKsveFIRq9kykqzGe4ZYobErFfiw',
  DASHBOARD_URL: 'https://sar-uae-ops-dashboard.vercel.app',   // TODO: confirm once the Vercel project exists
  EVA_TABS: ['CY2025', 'CY2026'],
  CHUNK: 500
};

// ─────────────────────────────── pure helpers (no Google services) ───────────────────────────────

// Column header -> field name, exactly as the USA sync names them:
// "Unbilled Revenue (D=A-C)" -> unbilledRevenueD=aC, "TOI / Inco Terms" -> toiIncoTerms,
// "Estimated Revenue (AED)" -> estimatedRevenueAed, "ETD/ETA New" -> etdEtaNew
function uaeFieldName(h) {
  var parts = String(h || '').trim().split(/[\s()\/.%,'-]+/).filter(function (p) { return p; });
  return parts.map(function (p, i) {
    var w = p.toLowerCase();
    return i === 0 ? w : w.charAt(0).toUpperCase() + w.slice(1);
  }).join('');
}

// "76,069.36" -> 76069.36, "(0.22)" -> -0.22, "16.49 %" -> 16.49, 12 -> 12, "" -> ""
function uaeNum(v) {
  if (typeof v === 'number') return v;
  var s = String(v == null ? '' : v).trim();
  if (!s) return '';
  var neg = /^\(.*\)$/.test(s) || /^-/.test(s);
  var t = s.replace(/[(),%\s]/g, '').replace(/^-/, '');
  if (!/^\d+(\.\d+)?$/.test(t)) return v;          // not a number - keep the text
  var n = parseFloat(t);
  return neg ? -n : n;
}

var UAE_MONTHS = { jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5, jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11 };
// "2025-06-06 00:00:00" / "2026-08-17 0:00:00" / "06-Jun-2025" / Date -> Date (script time zone), else ""
function uaeDate(v) {
  if (v instanceof Date) return isNaN(v) ? '' : v;
  var s = String(v == null ? '' : v).trim();
  if (!s) return '';
  var m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})(?:[ T](\d{1,2}):(\d{2})(?::(\d{2}))?)?/);
  if (m) return new Date(+m[1], +m[2] - 1, +m[3], +(m[4] || 0), +(m[5] || 0), +(m[6] || 0));
  m = s.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{4})/);
  if (m && UAE_MONTHS[m[2].toLowerCase()] != null) return new Date(+m[3], UAE_MONTHS[m[2].toLowerCase()], +m[1]);
  return '';
}

var UAE_DATE_FIELDS = /date|^eta|^etd|^ata|^atd|financialLock$|delivery|pickup/i;
var UAE_TEXT_FIELDS = /^(shipmentNo|masterNo|houseNo|consolNo|carrierNumber|consigneeZipCode|shipperZipCode|shipperRefNo|consigneeRef|masterShipmentNo)$/;

function uaeCell(field, v) {
  if (UAE_TEXT_FIELDS.test(field)) return String(v == null ? '' : v).trim();
  if (UAE_DATE_FIELDS.test(field)) { var d = uaeDate(v); return d === '' ? (typeof v === 'string' ? v.trim() : '') : d; }
  return uaeNum(typeof v === 'string' ? v.trim() : v);
}

function uaeDirection(lob) {
  var l = String(lob || '').toUpperCase();
  return l.indexOf('EXPORT') !== -1 ? 'Export' : l.indexOf('IMPORT') !== -1 ? 'Import' : '';
}

// ETD for exports, ETA for imports, job date as the last resort (USA's ETD/ETA New rule)
function uaeEtdEtaNew(j) {
  var d = j.direction === 'Export' ? (j.etdLoadingPort || j.etdFirstLegOfOrigin)
        : j.direction === 'Import' ? (j.etaDischarge || j.etaLastLegOfDestination) : '';
  return d || j.jobDate || '';
}

/**
 * The JPA tab holds several reports one under another, each with a title block, its own
 * "Shipment No" header row and a "Generated by ..." footer. Keeps every job row (first column
 * filled, LOB filled), later reports win on a repeated Shipment No.
 */
function uaeParseJpa(rows) {
  var header = null, jobs = {}, order = [];
  rows.forEach(function (r) {
    var a = String(r[0] == null ? '' : r[0]).trim();
    if (a === 'Shipment No') { header = r.map(uaeFieldName); return; }
    if (!header || !a) return;
    var lobIdx = header.indexOf('lob');
    if (lobIdx < 0 || !String(r[lobIdx] || '').trim()) return;        // title / footer / "Generated by" rows
    var j = {};
    header.forEach(function (f, i) { if (f) j[f] = uaeCell(f, r[i]); });
    j.shipmentNo = a;
    j.shipmentId = a;
    j.direction = uaeDirection(j.lob);
    j.etdEtaNew = uaeEtdEtaNew(j);
    j.fiscalYear = j.jobDate instanceof Date ? j.jobDate.getFullYear() : '';
    if (!jobs[a]) order.push(a);
    jobs[a] = j;
  });
  return order.map(function (k) { return jobs[k]; });
}

function uaeDay(d) { return d instanceof Date ? new Date(d.getFullYear(), d.getMonth(), d.getDate()) : ''; }

/**
 * Estimated vs Actual lines (one per charge) + what the dashboard needs from the job:
 * ETD/ETA New, Operation / Financial Lock, Job Owner, LOB, ATA/ATD, ETA/ETD.
 * Unbilled = Estimated - Booked revenue, Unposted = Estimated - Booked cost, both 0 once the
 * job is financially locked (the rule the USA lines follow).
 */
function uaeParseLines(tabs, jobs) {
  var byId = {};
  jobs.forEach(function (j) { byId[j.shipmentId] = j; });
  var out = [];
  Object.keys(tabs).forEach(function (tab) {
    var rows = tabs[tab] || [];
    if (!rows.length) return;
    var header = rows[0].map(uaeFieldName);
    var year = +String(tab).replace(/\D/g, '') || '';
    rows.slice(1).forEach(function (r) {
      var l = {};
      header.forEach(function (f, i) { if (f) l[f] = uaeCell(f, r[i]); });
      var id = String(l.jobNo || '').trim();
      if (!id || !String(l.lob || '').trim()) return;                 // blank / total rows
      l.jobNo = id; l.shipmentId = id; l.fiscalYear = year;
      var j = byId[id] || {};
      l.etdEtaNew = j.etdEtaNew || '';
      l.etaEtd = uaeDay(j.etdEtaNew);
      l.ataAtd = j.direction === 'Import' ? (j.ataDischarge || j.ataLastLegOfDestination || '')
               : (j.atdLoadingPort || j.atdFirstLegOfOrigin || '');
      l.operationLockDate = j.operationLockDate || '';
      l.financialLockDate = j.financialLock || '';
      l.jobOwner = j.jobOwner || '';
      l.lobExportImport = j.lob || '';
      var locked = !!l.financialLockDate;
      var n = function (v) { return typeof v === 'number' ? v : 0; };
      l.unbilledRevenue = locked ? 0 : Math.round((n(l.estimatedRevenueAed) - n(l.bookedRevenueAed)) * 100) / 100;
      l.unpostedCost = locked ? 0 : Math.round((n(l.estimatedCostAed) - n(l.bookedCostAed)) * 100) / 100;
      out.push(l);
    });
  });
  return out;
}

// Ops Mapping tab: Job Owner | Job Owner Email | Reporting To | Reporting To Email
function uaeParseOpsMapping(rows) {
  return (rows || []).slice(1).filter(function (r) { return String(r[0] || '').trim(); }).map(function (r) {
    return { jobOwner: String(r[0]).trim(), jobOwnerEmail: String(r[1] || '').trim().toLowerCase(),
             reportingTo: String(r[2] || '').trim(), reportingToEmail: String(r[3] || '').trim().toLowerCase() };
  });
}

// ─────────────────────────────── Google side ───────────────────────────────

var UAE_TABS = { jobs: 'Jobs', lines: 'ETD-ETA Lines', ops: 'Ops Mapping' };

/** One-time: create the three tabs in the source sheet and remove the CargoWise template tabs. */
function setupUaeSheet() {
  var ss = SpreadsheetApp.openById(UAE.DEST_ID);
  [UAE_TABS.jobs, UAE_TABS.lines, UAE_TABS.ops].forEach(function (n) { if (!ss.getSheetByName(n)) ss.insertSheet(n); });
  var ops = ss.getSheetByName(UAE_TABS.ops);
  if (ops.getLastRow() === 0) ops.getRange(1, 1, 1, 4).setValues([['Job Owner', 'Job Owner Email', 'Reporting To', 'Reporting To Email']]).setFontWeight('bold');
  ['Cover Note', 'Sheet1', 'Filter', 'Sort', 'Optional Templates'].forEach(function (n) {
    var s = ss.getSheetByName(n);
    if (s && ss.getSheets().length > 1) ss.deleteSheet(s);
  });
}

function uaeReadJpaRows() {
  var ss = SpreadsheetApp.openById(UAE.JPA_ID);
  var sh = ss.getSheets().filter(function (s) { return /^all lob/i.test(s.getName()); })[0];
  if (!sh) throw new Error("JPA - SAR_UAE: no \"All LOB's\" tab");
  return sh.getDataRange().getValues();
}

function uaeReadEvaTabs() {
  var ss = SpreadsheetApp.openById(UAE.EVA_ID), out = {};
  UAE.EVA_TABS.forEach(function (t) { var s = ss.getSheetByName(t); out[t] = s ? s.getDataRange().getValues() : []; });
  return out;
}

function uaeWriteTab(name, records) {
  var sh = SpreadsheetApp.openById(UAE.DEST_ID).getSheetByName(name);
  if (!sh) throw new Error('Run setupUaeSheet() first - tab missing: ' + name);
  sh.clearContents();
  if (!records.length) return;
  var keys = Object.keys(records[0]);
  records.forEach(function (r) { Object.keys(r).forEach(function (k) { if (keys.indexOf(k) < 0) keys.push(k); }); });
  var values = [keys].concat(records.map(function (r) { return keys.map(function (k) { return r[k] === undefined ? '' : r[k]; }); }));
  sh.getRange(1, 1, values.length, keys.length).setValues(values);
  sh.getRange(1, 1, 1, keys.length).setFontWeight('bold');
}

function uaePost(payload) {
  var secret = PropertiesService.getScriptProperties().getProperty('BATCH_SECRET');
  if (!secret) throw new Error('Script property BATCH_SECRET is not set');
  var resp = UrlFetchApp.fetch(UAE.DASHBOARD_URL + '/api/mongo-batch', {
    method: 'post', contentType: 'application/json', headers: { 'x-batch-secret': secret },
    payload: JSON.stringify(payload), muteHttpExceptions: true });
  if (resp.getResponseCode() !== 200) throw new Error('mongo-batch ' + payload.action + ' ' + payload.direction + ': HTTP ' + resp.getResponseCode() + ' ' + resp.getContentText().slice(0, 300));
  return JSON.parse(resp.getContentText());
}

function uaePush(direction, records) {
  uaePost({ action: 'wipe', direction: direction });
  for (var i = 0; i < records.length; i += UAE.CHUNK) uaePost({ action: 'push', direction: direction, records: records.slice(i, i + UAE.CHUNK) });
}

/** Daily: read both RPA sheets -> source sheet tabs -> dashboard database. */
function dailySyncUae() {
  var started = new Date();
  var jobs = uaeParseJpa(uaeReadJpaRows());
  var lines = uaeParseLines(uaeReadEvaTabs(), jobs);
  var opsRows = SpreadsheetApp.openById(UAE.DEST_ID).getSheetByName(UAE_TABS.ops);
  var ops = uaeParseOpsMapping(opsRows ? opsRows.getDataRange().getValues() : []);
  uaeWriteTab(UAE_TABS.jobs, jobs);
  uaeWriteTab(UAE_TABS.lines, lines);
  uaePush('Jobs', jobs);
  uaePush('EtdEta', lines);
  if (ops.length) uaePush('OpsMapping', ops);
  Logger.log('UAE sync: %s jobs, %s lines, %s ops mapping rows in %ss', jobs.length, lines.length, ops.length, Math.round((new Date() - started) / 1000));
}

/** Runs dailySyncUae every day around 10:30 IST (the RPA refreshes the JPA at ~10:07). */
function setupDailyTrigger() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'dailySyncUae') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('dailySyncUae').timeBased().everyDays(1).atHour(10).nearMinute(30).inTimezone('Asia/Kolkata').create();
}

if (typeof module !== 'undefined') module.exports = { uaeFieldName: uaeFieldName, uaeNum: uaeNum, uaeDate: uaeDate, uaeParseJpa: uaeParseJpa, uaeParseLines: uaeParseLines, uaeParseOpsMapping: uaeParseOpsMapping };
